# ==========================================
# Configuración de Variables de Entorno (Django)
# ==========================================
# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env

# SEGURIDAD Y MODO DE EJECUCIÓN
# -------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-n1th0c$%az@*zml=2zhke)h(azu9jw_is(y2@rb0-=-+4+n@2c

# PREFIJO Y VERSIÓN DE LA API REST
# -------------------------------------------------------------
# Permite cambiar la versión de la API dinámicamente sin tocar código (ej. api/v1/, api/v2/)
API_PREFIX=api/v1/

# ENTORNO DE BASE DE DATOS (PRODUCCIÓN vs DESARROLLO)
# -------------------------------------------------------------
# PRODUCTION=True  -> Utiliza PostgreSQL
# PRODUCTION=False -> Utiliza SQLite (por defecto en desarrollo)
PRODUCTION=False

# CONFIGURACIÓN POSTGRESQL (Solo se usa si PRODUCTION=True)
# -------------------------------------------------------------
# Opción 1: Mediante URL completa (recomendado para Cloud/Docker/Render/Railway)
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/gestion_comercial

# Opción 2: Parámetros individuales (si no defines DATABASE_URL)
DB_NAME=gestion_comercial
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# HOSTS Y ORÍGENES PERMITIDOS (Valores separados por coma)
# -------------------------------------------------------------
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# INTERNACIONALIZACIÓN Y ZONA HORARIA
# -------------------------------------------------------------
LANGUAGE_CODE=es-es
TIME_ZONE=UTC

# ARCHIVOS ESTÁTICOS Y MULTIMEDIA
# -------------------------------------------------------------
STATIC_URL=/static/
MEDIA_URL=/media/

# =============================================================
# ACTIVE DIRECTORY (AD / LDAP) - AUTENTICACIÓN Y GRUPOS/GPO
# =============================================================
# Activar o desactivar autenticación con Directorio Activo (True / False)
LDAP_ENABLED=False

# Servidor de Dominio (Controlador de Dominio / DC)
# Ej: ldap://192.168.1.10:389  o  ldaps://dc01.empresa.local:636
LDAP_SERVER_URI=ldap://192.168.1.10:389
LDAP_PORT=389
LDAP_USE_SSL=False
LDAP_CONNECT_TIMEOUT=5

# Dominio NetBIOS o FQDN (ej. MIEMPRESA o empresa.local)
LDAP_DOMAIN=empresa.local

# Cuenta de Servicio para búsqueda (Opcional pero muy recomendada en AD corporativo)
# Si se deja vacío, realiza bind directo del usuario con su contraseña
LDAP_BIND_DN=CN=svc_django,OU=ServiceAccounts,DC=empresa,DC=local
LDAP_BIND_PASSWORD=PasswordDeLaCuentaDeServicio!
LDAP_SEARCH_BASE=DC=empresa,DC=local

# CONTROL DE ACCESO POR GPO O GRUPO DE SEGURIDAD
# -------------------------------------------------------------
# Especifica uno o más grupos requeridos separados por coma (ej. CN o Nombre del grupo).
# Si un usuario de AD se autentica pero NO pertenece a ninguno de estos grupos,
# su acceso será DENEGADO automáticamente:
LDAP_REQUIRED_GROUPS=GestionComercial_Usuarios,GPO_AccesoSistemas

# MAPEO DE PERMISOS DJANGO POR GRUPO DE AD
# -------------------------------------------------------------
# Miembros de estos grupos tendrán acceso al panel de administración (is_staff = True):
LDAP_STAFF_GROUPS=GestionComercial_Operadores,GestionComercial_Admin

# Miembros de estos grupos serán Superusuarios en Django (is_superuser = True):
LDAP_SUPERUSER_GROUPS=GestionComercial_Admin,Domain Admins

# =============================================================
# SEGURIDAD Y TOKENS JWT
# =============================================================
# Clave secreta para firma de tokens (por defecto usa SECRET_KEY)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Tiempo de expiración del token de acceso (en minutos, por defecto 60)
JWT_ACCESS_EXPIRATION_MINUTES=60
# Tiempo de expiración del token de renovación (en días, por defecto 7)
JWT_REFRESH_EXPIRATION_DAYS=7
